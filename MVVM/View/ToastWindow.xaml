<Window
    x:Class="Filmauswertung_ModernUI.MVVM.View.ToastWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Filmauswertung_ModernUI.MVVM.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Toast"
    Height="50"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="Width"
    Topmost="True"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d">
    <!--  👈 Automatically adjusts width  -->

    <Border
        Padding="10"
        Background="#CC000000"
        CornerRadius="8">
        <TextBlock
            MaxWidth="800"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontSize="14"
            Foreground="White"
            Text="{Binding ToastMessage}"
            TextWrapping="Wrap" />
        <!--  👈 Optional: Prevent overly wide toasts  -->
    </Border>
</Window>
