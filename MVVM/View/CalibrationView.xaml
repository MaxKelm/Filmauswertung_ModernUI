<UserControl
    x:Class="Filmauswertung_ModernUI.MVVM.View.CalibrationView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:Filmauswertung_ModernUI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:extensions="clr-namespace:Filmauswertung_ModernUI.Core"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:oxy="http://oxyplot.org/wpf"
    xmlns:viewModel="clr-namespace:Filmauswertung_ModernUI.MVVM.ViewModel"
    d:DesignHeight="600"
    d:DesignWidth="1000"
    Background="Transparent"
    mc:Ignorable="d">

    <UserControl.DataContext>
        <viewModel:CalibrationViewModel />
    </UserControl.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="225" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="160" />
            </Grid.ColumnDefinitions>

            <!--  Left Panel: List + Controls  -->
            <Grid Grid.Column="0" Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ListView
                    ItemsSource="{Binding CalibrationFileNamesView}"
                    SelectedItem="{Binding SelectedCalibrationFile}"
                    Style="{StaticResource DynamicListView}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding FileNameWithoutExtension}" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel
                    Grid.Row="1"
                    Height="50"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal">
                    <Button
                        Width="225"
                        Height="40"
                        Padding="0,0,0,7"
                        Command="{Binding RemoveCommand}"
                        Content="✖"
                        FontSize="20"
                        Style="{StaticResource TitleButtons}" />
                </StackPanel>
            </Grid>

            <Grid Grid.Column="1" Margin="10">
                <oxy:PlotView
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="Transparent"
                    Model="{Binding CalibrationPlotModel}"
                    Visibility="{Binding CalibrationPlotModel, Converter={StaticResource NullToVisibilityConverter}}" />

                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="18"
                    FontStyle="Italic"
                    Foreground="Gray"
                    Text="Import irradiated films and enter associated dose values separated by ';'.&#x0a;You can either use ',' or '.' as decimal separator.&#x0a;Always include a background scan and dose value '0'.&#x0a;The order of images and values does not matter."
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    Visibility="{Binding CalibrationPlotModel, Converter={StaticResource InverseNullToVisibilityConverter}}" />
            </Grid>




            <!--  Right Panel: Controls  -->
            <StackPanel
                Grid.Column="2"
                Margin="10"
                VerticalAlignment="Top">
                <Button
                    Height="50"
                    Margin="0,30,0,10"
                    extensions:Extensions.Icon="📤"
                    Command="{Binding ImportCommand}"
                    Content="Import"
                    Style="{StaticResource DynamicButton}" />
                <Button
                    Height="50"
                    extensions:Extensions.Icon="💾"
                    Command="{Binding SaveCommand}"
                    Content="Save"
                    Style="{StaticResource DynamicButton}" />
            </StackPanel>
        </Grid>

        <!--  Bottom Bar: TextField + Unit Dropdown + Process  -->
        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="100" />
            </Grid.ColumnDefinitions>

            <TextBox
                Grid.Column="0"
                Margin="5,0"
                VerticalContentAlignment="Center"
                FontSize="14"
                Style="{StaticResource DynamicTextBox}"
                Text="{Binding CalibrationInputText, Mode=TwoWay}" />

            <ComboBox
                Grid.Column="1"
                Margin="5,0"
                VerticalContentAlignment="Center"
                FontSize="14"
                ItemsSource="{Binding Units}"
                SelectedItem="{Binding SelectedUnit}"
                Style="{StaticResource DynamicComboBox}" />

            <Button
                Grid.Column="2"
                Height="60"
                extensions:Extensions.Icon="▶"
                Command="{Binding ProcessCommand}"
                Content="Process"
                Style="{StaticResource DynamicButton}" />
        </Grid>
    </Grid>
</UserControl>
