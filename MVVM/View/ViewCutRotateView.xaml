<UserControl
    x:Class="Filmauswertung_ModernUI.MVVM.View.ViewCutRotateView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:extensions="clr-namespace:Filmauswertung_ModernUI.Core"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModel="clr-namespace:Filmauswertung_ModernUI.MVVM.ViewModel"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Background="Transparent"
    mc:Ignorable="d">

    <UserControl.DataContext>
        <viewModel:ViewCutRotateViewModel />
    </UserControl.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  Top Region: Buttons (directly in the grid)  -->
        <RadioButton
            Grid.Row="0"
            Grid.Column="0"
            Margin="2"
            Padding="10,5"
            extensions:Extensions.Icon="👁️"
            Command="{Binding SelectViewCommand}"
            Content="View"
            Style="{StaticResource ToolbarButtons}" />

        <RadioButton
            Grid.Row="0"
            Grid.Column="1"
            Margin="2"
            Padding="10,5"
            extensions:Extensions.Icon="✂️"
            Command="{Binding SelectCutCommand}"
            Content="Cut"
            IsChecked="True"
            Style="{StaticResource ToolbarButtons}" />

        <RadioButton
            Grid.Row="0"
            Grid.Column="2"
            Margin="2,2,5,2"
            Padding="10,5"
            extensions:Extensions.Icon="🔄"
            Command="{Binding SelectRotateCommand}"
            Content="Rotate"
            Style="{StaticResource ToolbarButtons}" />

        <ContentPresenter
            Grid.Row="1"
            Grid.ColumnSpan="3"
            Margin="10"
            Content="{Binding SelectedContentView}" />
    </Grid>
</UserControl>
