<UserControl
    x:Class="Filmauswertung_ModernUI.MVVM.View.ViewCutRotateViews.CutView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:extensions="clr-namespace:Filmauswertung_ModernUI.Core"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toggle="clr-namespace:Filmauswertung_ModernUI.Services"
    xmlns:viewModel="clr-namespace:Filmauswertung_ModernUI.MVVM.ViewModel.ViewCutRotateViewModels"
    d:DesignHeight="600"
    d:DesignWidth="1000"
    Background="Transparent"
    mc:Ignorable="d">

    <UserControl.DataContext>
        <viewModel:CutViewModel />
    </UserControl.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!--  Image and Overlay  -->
        <Grid Grid.Column="0" ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Viewbox
                Grid.Row="0"
                Stretch="Uniform"
                StretchDirection="Both">
                <Grid>
                    <Image
                        x:Name="TifImage"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        MouseLeftButtonDown="OnImageMouseLeftButtonDown"
                        Source="{Binding DisplayedImage}"
                        Stretch="None" />

                    <!--  The canvas for markers and rectangles  -->
                    <Canvas
                        x:Name="RoiCanvas"
                        Background="Transparent"
                        IsHitTestVisible="False" />
                    <Canvas
                        x:Name="MarkerCanvas"
                        Background="Transparent"
                        IsHitTestVisible="False" />
                </Grid>
            </Viewbox>

            <!--  Sliders  -->
            <Grid Grid.Row="1" Margin="20,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                    <TextBlock
                        HorizontalAlignment="Center"
                        Foreground="LightGray"
                        Text="Contrast" />
                    <Slider
                        Width="200"
                        extensions:Extensions.DisplayValue="{Binding ContrastSliderLabel}"
                        IsSnapToTickEnabled="True"
                        Maximum="4"
                        Minimum="1"
                        Style="{StaticResource DynamicSlider}"
                        TickFrequency="1"
                        Value="{Binding ContrastValue, Mode=TwoWay}" />
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                    <TextBlock
                        HorizontalAlignment="Center"
                        Foreground="LightGray"
                        Text="Margin" />
                    <Slider
                        Width="200"
                        extensions:Extensions.DisplayValue="{Binding MarginSliderLabel}"
                        IsSnapToTickEnabled="True"
                        Maximum="3"
                        Minimum="0"
                        Style="{StaticResource DynamicSlider}"
                        TickFrequency="1"
                        Value="{Binding MarginValue, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                    <TextBlock
                        HorizontalAlignment="Center"
                        Foreground="LightGray"
                        Text="Tolerance" />
                    <Slider
                        Width="200"
                        extensions:Extensions.DisplayValue="{Binding ToleranceSliderLabel}"
                        IsSnapToTickEnabled="True"
                        Maximum="{Binding ToleranceMax}"
                        Minimum="1"
                        Style="{StaticResource DynamicSlider}"
                        TickFrequency="1"
                        Value="{Binding ToleranceValue, Mode=TwoWay}" />
                </StackPanel>
            </Grid>
        </Grid>

        <!--  Buttons  -->
        <StackPanel
            Grid.Column="1"
            Width="140"
            Margin="10"
            VerticalAlignment="Top">
            <!--  Mode Toggle  -->
            <ToggleButton
                Height="60"
                toggle:ToggleSwitchHelper.IconChecked="✨"
                toggle:ToggleSwitchHelper.IconUnchecked="🖊️"
                toggle:ToggleSwitchHelper.LabelChecked="Automatic"
                toggle:ToggleSwitchHelper.LabelUnchecked="Manual"
                IsChecked="{Binding IsBatchCutMode, Mode=TwoWay}"
                Style="{StaticResource DynamicToggleButton}" />

            <Button
                Height="60"
                Margin="0,0,0,10"
                extensions:Extensions.Icon="📤"
                Command="{Binding UploadTifCommand}"
                Content="Upload .tif"
                Style="{StaticResource DynamicButton}" />

            <Button
                Height="60"
                Margin="0,0,0,10"
                extensions:Extensions.Icon="💾"
                Command="{Binding SaveSegmentsCommand}"
                Content="Save Segment(s)"
                Style="{StaticResource DynamicButton}" />

            <Button
                Height="60"
                Margin="0,0,0,10"
                extensions:Extensions.Icon="↩️"
                Command="{Binding RemoveLastMarkerCommand}"
                Content="Remove Last"
                Style="{StaticResource DynamicButton}" />

            <Button
                Height="60"
                extensions:Extensions.Icon="❌"
                Command="{Binding ClearMarkersCommand}"
                Content="Remove All"
                Style="{StaticResource DynamicButton}" />
        </StackPanel>
    </Grid>
</UserControl>
