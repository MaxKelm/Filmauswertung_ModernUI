<UserControl
    x:Class="Filmauswertung_ModernUI.MVVM.View.ViewCutRotateViews.CutView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:extensions="clr-namespace:Filmauswertung_ModernUI.Core"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModel="clr-namespace:Filmauswertung_ModernUI.MVVM.ViewModel.ViewCutRotateViewModels"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Background="Transparent"
    mc:Ignorable="d">

    <UserControl.DataContext>
        <viewModel:CutViewModel />
    </UserControl.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  Top toolbar with two evenly spaced buttons  -->
        <RadioButton
            Grid.Row="0"
            Grid.Column="0"
            Margin="2"
            Padding="10,5"
            extensions:Extensions.Icon="📄"
            Command="{Binding SelectSingleCutCommand}"
            Content="Single Cut"
            Style="{StaticResource ToolbarButtons}" />

        <RadioButton
            Grid.Row="0"
            Grid.Column="1"
            Margin="2"
            Padding="10,5"
            extensions:Extensions.Icon="📑"
            Command="{Binding SelectBatchCutCommand}"
            Content="Batch Cut"
            IsChecked="True"
            Style="{StaticResource ToolbarButtons}" />

        <!--  ContentPresenter for subviews  -->
        <ContentPresenter
            Grid.Row="1"
            Grid.ColumnSpan="2"
            Margin="10"
            Content="{Binding SelectedContentView}" />
    </Grid>
</UserControl>
