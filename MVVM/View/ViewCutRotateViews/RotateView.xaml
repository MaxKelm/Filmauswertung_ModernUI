<UserControl
    x:Class="Filmauswertung_ModernUI.MVVM.View.ViewCutRotateViews.RotateView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:extensions="clr-namespace:Filmauswertung_ModernUI.Core"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toggle="clr-namespace:Filmauswertung_ModernUI.Services"
    xmlns:viewModel="clr-namespace:Filmauswertung_ModernUI.MVVM.ViewModel.ViewCutRotateViewModels"
    d:DesignHeight="600"
    d:DesignWidth="1000"
    Background="Transparent"
    mc:Ignorable="d">

    <UserControl.DataContext>
        <viewModel:RotateViewModel />
    </UserControl.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!--  Left: Image Area  -->
        <Viewbox
            Grid.Column="0"
            Stretch="Uniform"
            StretchDirection="Both">
            <Image
                x:Name="TifImage"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Source="{Binding DisplayedImage}"
                Stretch="None" />
        </Viewbox>

        <!--  Right: Controls  -->
        <StackPanel
            Grid.Column="1"
            Width="160"
            Margin="10"
            VerticalAlignment="Top">

            <TextBlock
                Margin="0,0,0,10"
                FontSize="20"
                FontWeight="SemiBold"
                Foreground="White"
                Text="Image Rotation" />

            <Button
                Height="50"
                Margin="0,0,0,10"
                extensions:Extensions.Icon="📤"
                Command="{Binding ImportCommand}"
                Content="Import .tif"
                Style="{StaticResource DynamicButton}" />

            <Button
                Height="50"
                Margin="0,0,0,10"
                extensions:Extensions.Icon="↻"
                Command="{Binding RotateRightCommand}"
                Content="Rotate Right"
                Style="{StaticResource DynamicButton}" />

            <Button
                Height="50"
                Margin="0,0,0,10"
                extensions:Extensions.Icon="↺"
                Command="{Binding RotateLeftCommand}"
                Content="Rotate Left"
                Style="{StaticResource DynamicButton}" />

            <Button
                Height="50"
                Margin="0,0,0,10"
                extensions:Extensions.Icon="⇋"
                Command="{Binding MirrorCommand}"
                Content="Mirror"
                Style="{StaticResource DynamicButton}" />

            <Button
                Height="50"
                extensions:Extensions.Icon="💾"
                Command="{Binding SaveCommand}"
                Content="Save .tif"
                Style="{StaticResource DynamicButton}" />
        </StackPanel>
    </Grid>
</UserControl>
