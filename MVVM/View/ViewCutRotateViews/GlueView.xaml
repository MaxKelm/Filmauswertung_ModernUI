<UserControl
    x:Class="Filmauswertung_ModernUI.MVVM.View.ViewCutRotateViews.GlueView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:extensions="clr-namespace:Filmauswertung_ModernUI.Core"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModel="clr-namespace:Filmauswertung_ModernUI.MVVM.ViewModel.ViewCutRotateViewModels"
    d:DesignHeight="600"
    d:DesignWidth="1000"
    Background="Transparent"
    mc:Ignorable="d">

    <UserControl.DataContext>
        <viewModel:GlueViewModel />
    </UserControl.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Main Content  -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="225" />
                <!--  ListView  -->
                <ColumnDefinition Width="*" />
                <!--  Image  -->
                <ColumnDefinition Width="160" />
                <!--  Buttons  -->
            </Grid.ColumnDefinitions>

            <Grid
                Grid.Column="0"
                Margin="10"
                VerticalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <!--  Buttons fixed height  -->
                    <RowDefinition Height="50" />
                    <!--  ListView takes remaining space  -->
                </Grid.RowDefinitions>

                <!--  Buttons  -->
                <StackPanel
                    Grid.Row="1"
                    Height="50"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal">
                    <Button
                        Width="50"
                        Height="50"
                        Padding="0,0,0,5"
                        extensions:Extensions.Icon="↑"
                        Command="{Binding MoveUpCommand}"
                        Content="↑"
                        FontSize="30"
                        Style="{StaticResource TitleButtons}" />

                    <Button
                        Width="50"
                        Height="50"
                        Padding="0,0,0,5"
                        Command="{Binding MoveDownCommand}"
                        Content="↓"
                        FontSize="30"
                        Style="{StaticResource TitleButtons}" />

                    <Button
                        Width="50"
                        Height="50"
                        Padding="0,0,0,3"
                        Command="{Binding RemoveCommand}"
                        Content="✖"
                        FontSize="20"
                        Style="{StaticResource TitleButtons}" />
                </StackPanel>

                <!--  ListView  -->
                <ListView
                    Grid.Row="0"
                    ItemsSource="{Binding ImageFileNamesView}"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    SelectedItem="{Binding SelectedImage}"
                    Style="{StaticResource DynamicListView}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn DisplayMemberBinding="{Binding}" Header="File Name" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>



            <!--  Center: Image Display  -->
            <Viewbox
                Grid.Column="1"
                Margin="10"
                Stretch="Uniform"
                StretchDirection="Both"
                Visibility="{Binding DisplayedImage, Converter={StaticResource NullToVisibilityConverter}}">
                <Image
                    x:Name="PreviewImage"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Source="{Binding DisplayedImage}"
                    Stretch="None" />
            </Viewbox>
            <!--  Placeholder message when no image is loaded  -->
            <TextBlock
                Grid.Column="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="18"
                FontStyle="Italic"
                Foreground="Gray"
                Text="Load several .tif files to combine as new single .tif image. &#x0a;Use the ListView controls to rearrange the displayed images.&#x0a;Use the 'X' to remove single images and '↑' and '↓' to change the order. &#x0a;Use the column slider to determine the shape of the arrangement.&#x0a;Save as new .tif image."
                TextAlignment="Center"
                TextWrapping="Wrap"
                Visibility="{Binding DisplayedImage, Converter={StaticResource InverseNullToVisibilityConverter}}" />

            <!--  Right: Controls  -->
            <StackPanel
                Grid.Column="2"
                Margin="10"
                VerticalAlignment="Top">
                <Button
                    Height="50"
                    Margin="0,0,0,10"
                    extensions:Extensions.Icon="📤"
                    Command="{Binding ImportCommand}"
                    Content="Import .tif"
                    Style="{StaticResource DynamicButton}" />

                <Button
                    Height="50"
                    extensions:Extensions.Icon="💾"
                    Command="{Binding SaveCommand}"
                    Content="Save .tif"
                    Style="{StaticResource DynamicButton}" />
            </StackPanel>
        </Grid>

        <!--  Bottom: Sliders (aligned only with image column)  -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!--  Empty space for ListView column  -->
                <ColumnDefinition Width="225" />
                <!--  Actual sliders column for the image  -->
                <ColumnDefinition Width="*" />
                <!--  Spacer for buttons column  -->
                <ColumnDefinition Width="160" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="1" Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock
                        HorizontalAlignment="Center"
                        Foreground="White"
                        Text="Columns" />
                    <Slider
                        Width="200"
                        extensions:Extensions.DisplayValue="{Binding Columns}"
                        IsSnapToTickEnabled="True"
                        Maximum="{Binding ColumnMax}"
                        Minimum="1"
                        Style="{StaticResource DynamicSlider}"
                        TickFrequency="1"
                        Value="{Binding Columns, Mode=TwoWay}" />
                </StackPanel>
            </Grid>
        </Grid>

    </Grid>
</UserControl>
