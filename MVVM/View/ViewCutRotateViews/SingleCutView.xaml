<UserControl
    x:Class="Filmauswertung_ModernUI.MVVM.View.ViewCutRotateViews.SingleCutView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:extensions="clr-namespace:Filmauswertung_ModernUI.Core"
    xmlns:local="clr-namespace:Filmauswertung_ModernUI.MVVM.View.ViewCutRotateViews"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="600"
    d:DesignWidth="900"
    Background="Transparent"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!--  Image and ROI Canvas Container  -->
        <Grid Grid.Column="0" ClipToBounds="True">
            <!--  Use Viewbox if you want scaling with pixel accuracy and coordinate alignment  -->
            <Viewbox Stretch="Uniform" StretchDirection="Both">
                <Grid>
                    <Image
                        x:Name="MainImage"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Source="{Binding DisplayedImage}"
                        Stretch="None" />

                    <!--  ROI Canvas overlaid on image  -->
                    <Canvas x:Name="OverlayCanvas" IsHitTestVisible="False">
                        <Rectangle
                            x:Name="RoiRectangle"
                            Fill="#4000FF00"
                            Stroke="LimeGreen"
                            StrokeThickness="2"
                            Visibility="Collapsed" />
                    </Canvas>
                </Grid>
            </Viewbox>
        </Grid>

        <!--  Buttons  -->
        <StackPanel
            Grid.Column="1"
            Width="120"
            Margin="10"
            VerticalAlignment="Top"
            Orientation="Vertical">

            <Button
                Height="60"
                Margin="0,0,0,10"
                extensions:Extensions.Icon="📤"
                Background="#3C3A50"
                Command="{Binding UploadTifCommand}"
                Content="Upload .tif"
                Style="{StaticResource DynamicButton}" />

            <Button
                Height="60"
                Margin="0,0,0,10"
                extensions:Extensions.Icon="✏️"
                Background="#3C3A50"
                Command="{Binding DefineRoiCommand}"
                Content="Define ROI"
                Style="{StaticResource DynamicButton}" />

            <Button
                Height="60"
                extensions:Extensions.Icon="💾"
                Background="#3C3A50"
                Command="{Binding SaveRoiCommand}"
                Content="Save"
                Style="{StaticResource DynamicButton}" />
        </StackPanel>
    </Grid>

</UserControl>
