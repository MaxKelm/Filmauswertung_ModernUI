
<Window
    x:Class="Filmauswertung_ModernUI.MVVM.View.MainView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:extensions="clr-namespace:Filmauswertung_ModernUI.Core"
    xmlns:local="clr-namespace:Filmauswertung_ModernUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModel="clr-namespace:Filmauswertung_ModernUI.MVVM.ViewModel"
    Width="1200"
    Height="800"
    AllowsTransparency="True"
    Background="Transparent"
    Icon="/Images/icon.ico"
    ResizeMode="CanResizeWithGrip"
    WindowState="Maximized"
    WindowStyle="None"
    mc:Ignorable="d">

    <Window.DataContext>
        <viewModel:MainViewModel />
    </Window.DataContext>

    <DockPanel Margin="7" Background="#272537">
        <Border
            Height="28"
            Background="#272537"
            DockPanel.Dock="Top">
            <Border.InputBindings>
                <MouseBinding Command="{Binding MoveWindowCommand}" MouseAction="LeftClick" />
                <MouseBinding Command="{Binding MaximizeWindowCommand}" MouseAction="LeftDoubleClick" />
            </Border.InputBindings>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="100" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Margin="22,6,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    FontFamily="/Fonts/#Poppins"
                    FontSize="16"
                    Foreground="LightGray"
                    Text="Filmauswertung" />
                <StackPanel
                    Grid.Column="1"
                    Margin="0,0,4,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
                    <Button
                        Padding="0,0,0,0"
                        Command="{Binding MinimizeWindowCommand}"
                        Content="__"
                        FontSize="15"
                        Style="{StaticResource TitleButtons}" />
                    <Button
                        Padding="0,2,0,0"
                        Command="{Binding MaximizeWindowCommand}"
                        Content="⛶"
                        FontSize="15"
                        Style="{StaticResource TitleButtons}" />
                    <Button
                        Padding="0,3,0,0"
                        Command="{Binding ShutdownWindowCommand}"
                        Content="✖"
                        FontSize="11"
                        Style="{StaticResource TitleButtons}" />
                </StackPanel>
            </Grid>
        </Border>
        <Border
            Width="200"
            Margin="0,50,0,0"
            HorizontalAlignment="Left"
            Background="#272537">
            <StackPanel>
                <RadioButton
                    Height="50"
                    extensions:Extensions.Icon="&#9986;"
                    Command="{Binding ViewCutRotateCommand}"
                    Content="View | Cut | Rotate"
                    FontSize="14"
                    Foreground="White"
                    Style="{StaticResource MenuButtonTheme}"
                    Tag="20,0,0,0" />
                <RadioButton
                    Height="50"
                    extensions:Extensions.Icon="&#128208;"
                    Command="{Binding ViewCalibrationCommand}"
                    Content="Calibration"
                    FontSize="14"
                    Foreground="White"
                    Style="{StaticResource MenuButtonTheme}"
                    Tag="20,0,0,0" />
                <RadioButton
                    Height="50"
                    extensions:Extensions.Icon="&#10135;"
                    Command="{Binding ViewCalculationCommand}"
                    Content="Calculate and Convert"
                    FontSize="14"
                    Foreground="White"
                    IsChecked="True"
                    Style="{StaticResource MenuButtonTheme}"
                    Tag="20,0,0,0" />
                <RadioButton
                    Height="50"
                    extensions:Extensions.Icon="&#129482;"
                    Command="{Binding ViewDoseViewerCommand}"
                    Content="3D Dose Viewer"
                    FontSize="14"
                    Foreground="White"
                    Style="{StaticResource MenuButtonTheme}"
                    Tag="20,0,0,0" />
            </StackPanel>
        </Border>
        <ContentPresenter Content="{Binding CurrentView}" />
    </DockPanel>
</Window>
