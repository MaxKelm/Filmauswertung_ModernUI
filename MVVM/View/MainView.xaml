<Window
    x:Class="Filmauswertung_ModernUI.MVVM.View.MainView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Filmauswertung_ModernUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModel="clr-namespace:Filmauswertung_ModernUI.MVVM.ViewModel"
    Width="1020"
    Height="700"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="CanResize"
    WindowStyle="None"
    mc:Ignorable="d">

    <Window.DataContext>
        <viewModel:MainViewModel />
    </Window.DataContext>

    <DockPanel Margin="7" Background="#272537">
        <Border
            Height="28"
            Background="#272537"
            DockPanel.Dock="Top">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="100" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Margin="100,0,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontFamily="/Fonts/#Poppins"
                    Foreground="LightGray"
                    Text="Filmauswertung" />
                <StackPanel
                    Grid.Column="1"
                    Margin="0,0,4,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
                    <Button
                        Margin="0,0,0,2"
                        FontSize="15"
                        Command="{Binding MinimizeWindowCommand}"
                        Content="__" />
                    <Button
                        Margin="0,2,0,0"
                        FontSize="15"
                        Command="{Binding MaximizeWindowCommand}"
                        Content="⛶" />
                    <Button
                        Margin="0,0,0,0"
                        FontSize="17"
                        Command="{Binding ShutdownWindowCommand}"
                        Content="x" />
                </StackPanel>
            </Grid>
        </Border>
        <Border
            Width="180"
            HorizontalAlignment="Left"
            Background="#272537">
            <StackPanel>
                <RadioButton
                    Height="50"
                    Command="{Binding ViewCutRotateCommand}"
                    Content="View | Cut | Rotate"
                    FontSize="14"
                    Foreground="White"
                    Style="{StaticResource MenuButtonTheme}"
                    Tag="20,0,0,0" />
                <RadioButton
                    Height="50"
                    Command="{Binding ViewCalibrationCommand}"
                    Content="Calibration"
                    FontSize="14"
                    Foreground="White"
                    Style="{StaticResource MenuButtonTheme}"
                    Tag="20,0,0,0" />
                <RadioButton
                    Height="50"
                    Command="{Binding ViewCalculationCommand}"
                    Content="Calculate and Convert"
                    FontSize="14"
                    Foreground="White"
                    IsChecked="True"
                    Style="{StaticResource MenuButtonTheme}"
                    Tag="20,0,0,0" />
                <RadioButton
                    Height="50"
                    Command="{Binding ViewDoseViewerCommand}"
                    Content="3D Dose Viewer"
                    FontSize="14"
                    Foreground="White"
                    Style="{StaticResource MenuButtonTheme}"
                    Tag="20,0,0,0" />
            </StackPanel>
        </Border>
        <ContentPresenter Content="{Binding CurrentView}" />
    </DockPanel>
</Window>
