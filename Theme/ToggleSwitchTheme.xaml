<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:extensions="clr-namespace:Filmauswertung_ModernUI.Core"
    xmlns:toggle="clr-namespace:Filmauswertung_ModernUI.Services">

    <Style x:Key="DynamicToggleButton" TargetType="ToggleButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontFamily" Value="/Fonts/#Poppins" />
        <Setter Property="Padding" Value="10,5" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border
                        x:Name="border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="Transparent"
                        BorderThickness="1"
                        CornerRadius="5">
                        <StackPanel
                            x:Name="contentPanel"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Orientation="Vertical">

                            <TextBlock
                                x:Name="iconTextBlock"
                                FontFamily="/Fonts/#Poppins"
                                FontSize="20"
                                Foreground="{TemplateBinding Foreground}"
                                Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(toggle:ToggleSwitchHelper.IconUnchecked)}"
                                TextAlignment="Center" />

                            <TextBlock
                                x:Name="labelText"
                                Margin="0,4,0,0"
                                FontFamily="/Fonts/#Poppins"
                                Foreground="{TemplateBinding Foreground}"
                                Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(toggle:ToggleSwitchHelper.LabelUnchecked)}"
                                TextAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#33303050" />
                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#2E2C40" />
                        </Trigger>

                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="labelText" Property="Foreground" Value="#AA7CFC00" />
                            <Setter TargetName="iconTextBlock" Property="Foreground" Value="#AA7CFC00" />

                            <Setter TargetName="iconTextBlock" Property="Text" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(toggle:ToggleSwitchHelper.IconChecked)}" />
                            <Setter TargetName="labelText" Property="Text" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(toggle:ToggleSwitchHelper.LabelChecked)}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>



</ResourceDictionary>
