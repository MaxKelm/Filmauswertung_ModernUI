<Window
    x:Class="Filmauswertung_ModernUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Filmauswertung_ModernUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModel="clr-namespace:Filmauswertung_ModernUI.MVVM.ViewModel"
    Width="1020"
    Height="700"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="CanResizeWithGrip"
    WindowStyle="None"
    mc:Ignorable="d">

    <Window.DataContext>
        <viewModel:MainViewModel />
    </Window.DataContext>
    <Border
        Background="#272537"
        CornerRadius="20"
        MouseDown="Window_MouseDown">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="75" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <TextBlock
                Margin="20,0,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontFamily="/Fonts/#Poppins"
                FontSize="22"
                Foreground="White"
                Text="Filmauswertung" />

            <StackPanel Grid.Row="1">
                <RadioButton
                    Height="50"
                    Command="{Binding HomeViewCommand}"
                    Content="View | Cut | Rotate"
                    FontSize="14"
                    Foreground="White"
                    Style="{StaticResource MenuButtonTheme}"
                    Tag="20,0,0,0" />
                <RadioButton
                    Height="50"
                    Command="{Binding DiscoveryViewCommand}"
                    Content="Calibration"
                    FontSize="14"
                    Foreground="White"
                    Style="{StaticResource MenuButtonTheme}"
                    Tag="20,0,0,0" />
                <RadioButton
                    Height="50"
                    Command="{Binding HomeViewCommand}"
                    Content="Calculate and Convert"
                    FontSize="14"
                    Foreground="White"
                    IsChecked="True"
                    Style="{StaticResource MenuButtonTheme}"
                    Tag="20,0,0,0" />
                <RadioButton
                    Height="50"
                    Content="3D Dose Viewer"
                    FontSize="14"
                    Foreground="White"
                    Style="{StaticResource MenuButtonTheme}"
                    Tag="20,0,0,0" />
            </StackPanel>
            <StackPanel
                Grid.Column="1"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <TextBox
                    Grid.Column="1"
                    Width="570"
                    Height="40"
                    Margin="5"
                    VerticalAlignment="Center"
                    Style="{StaticResource ModernTextbox}" />
                <RadioButton
                    Width="100"
                    Height="50"
                    Margin="0,0,10,0"
                    HorizontalAlignment="Center"
                    Command="{Binding MinimizeCommand}"
                    Content="Minimize"
                    FontSize="14"
                    Foreground="White"
                    Style="{StaticResource MenuButtonTheme}"
                    Tag="20,0,0,0" />
                <RadioButton
                    Width="100"
                    Height="50"
                    HorizontalAlignment="Center"
                    Command="{Binding CloseCommand}"
                    Content="Close"
                    FontSize="14"
                    Foreground="White"
                    Style="{StaticResource MenuButtonTheme}"
                    Tag="30,0,0,0" />

            </StackPanel>
            <ContentControl
                Grid.Row="1"
                Grid.Column="1"
                Margin="10"
                Content="{Binding CurrentView}" />
        </Grid>
    </Border>
</Window>
